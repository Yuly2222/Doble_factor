SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Project Settings > API > service_role (secreta: solo en el backend, nunca en la web ni en la app)
SUPABASE_KEY=
# Cualquier cadena larga aleatoria: py -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# Clave AES-256 para cifrar totp_secret en Supabase (32 bytes en base64). Generarla con:
#   py -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Si se pierde, las semillas guardadas no se pueden descifrar (los usuarios deben re-escanear el QR).
TOTP_ENC_KEY=
PREFECT_API_URL=http://127.0.0.1:4200/api
DO_NOT_TRACK=1
